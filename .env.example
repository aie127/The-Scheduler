PORT=4174
HOST=0.0.0.0

# Supabase server-side credentials. Keep the service role key private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Generate a random 32-byte key and encode it as 64 hex characters.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Set this to the deployed API URL in production; register it in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:4174/oauth/google/callback

# Comma-separated exact planner origins allowed to call the API.
APP_ORIGINS=http://localhost:4173,http://192.168.1.60:4173
